{
  "name": "sky-gov-cheatsheet",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode netlify && node -e \"const fs=require('fs');try{fs.copyFileSync('dist/index.html','dist/404.html')}catch(e){}\"",
    "build:gh": "tsc -b && vite build --mode gh && node -e \"const fs=require('fs');try{fs.copyFileSync('docs/index.html','docs/404.html')}catch(e){}\"",
    "preview": "vite preview --port 4173 --strictPort",
    "scrape:laws": "node scripts/scrape-laws.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0-rc.12",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "lucide-react": "^0.471.2",
    "marked": "^16.2.0",
    "openai": "^5.20.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "turndown": "^7.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^5.4.2"
  }
}
