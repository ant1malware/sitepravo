VITE_API_BASE=https://sky-api.wizardiowhy.workers.dev
VITE_VOTE_API_BASE=https://sky-api.wizardiowhy.workers.dev
VITE_NOTIF_URL=https://notifications-worker.wizardiowhy.workers.dev/api/notifications
# NOTIFY_SECRET is used by Netlify function /.netlify/functions/tg-notify?secret=...
# NOTIFY_SECRET=change-me

# For GitHub Pages + Cloudflare Worker use instead:
# VITE_NOTIF_URL=https://<your-worker>.workers.dev/api/notifications
# And set Telegram webhook to:
# https://<your-worker>.workers.dev/tg-notify?secret=<your secret>
